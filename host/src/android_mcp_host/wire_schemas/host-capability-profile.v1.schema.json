{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:android-mcp:host-capability-profile:v1",
  "title": "Host safe capability profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "profile", "mutation_enabled", "target_authority", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime": {"const": "host"},
    "profile": {"enum": ["safe", "diagnostic"]},
    "mutation_enabled": {"const": false},
    "target_authority": {"const": false},
    "capabilities": {
      "type": "array",
      "maxItems": 95,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog_id", "risk", "state", "reason", "authorized"],
        "properties": {
          "catalog_id": {"type": "string", "pattern": "^[AHFPRE][0-9]{2}$"},
          "risk": {"enum": ["D0", "D1"]},
          "state": {"enum": [
            "runnable", "requires_target", "plan_only", "not_exposed",
            "unavailable", "implemented_disabled", "excluded_by_security"
          ]},
          "reason": {"type": "string", "maxLength": 64},
          "authorized": {"type": "boolean"}
        }
      }
    }
  }
}
