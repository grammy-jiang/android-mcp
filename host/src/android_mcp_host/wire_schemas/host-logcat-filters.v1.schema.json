{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:android-mcp:host-logcat-filters:v1",
  "title": "Bounded redacted Logcat filter result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "device_id", "status", "filters", "entries", "truncated", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime": {"const": "host"},
    "device_id": {"type": "string", "maxLength": 128},
    "status": {"enum": ["ok", "partial", "error", "timeout"]},
    "filters": {
      "type": "object", "additionalProperties": false,
      "required": ["tag", "package", "severity"],
      "properties": {
        "tag": {"type": ["string", "null"], "maxLength": 32},
        "package": {"type": ["string", "null"], "maxLength": 180},
        "severity": {"type": ["string", "null"], "enum": ["V", "D", "I", "W", "E", "F", null]}
      }
    },
    "entries": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["priority", "tag", "message"],
        "properties": {
          "priority": {"enum": ["V", "D", "I", "W", "E", "F"]},
          "tag": {"type": "string", "maxLength": 32},
          "message": {"type": "string", "maxLength": 512}
        }
      }
    },
    "truncated": {"type": "boolean"},
    "errors": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "maxLength": 64},
          "message": {"type": "string", "maxLength": 256}
        }
      }
    }
  }
}
