{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:android-mcp:host-synthetic-file-pull:v1",
  "title": "Private synthetic exact app-owned file export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "status",
    "file_state",
    "avd_name",
    "avd_handle",
    "lifecycle_job_id",
    "package_id",
    "filename",
    "mime_type",
    "job_id",
    "artifact_handle",
    "receipt_handle",
    "sha256",
    "size_bytes",
    "max_bytes",
    "source_kind",
    "privacy_class",
    "target",
    "synthetic_fixture_only",
    "real_pull_enabled",
    "physical_device_reads_enabled",
    "physical_device_writes_enabled",
    "raw_content_returned",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runtime": {
      "const": "host"
    },
    "status": {
      "enum": [
        "planned",
        "ok",
        "blocked",
        "failed",
        "uncertain"
      ]
    },
    "file_state": {
      "enum": [
        "none",
        "pulled_synthetic",
        "unknown"
      ]
    },
    "avd_name": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mcp_[A-Za-z0-9][A-Za-z0-9_-]{2,43}$"
    },
    "avd_handle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mcpavd_[A-Za-z0-9_-]{32}$"
    },
    "lifecycle_job_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^job_[A-Za-z0-9_-]{32}$"
    },
    "package_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^org\\.example\\.synthetic\\.[A-Za-z_][A-Za-z0-9_.]{0,100}$"
    },
    "filename": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "application/json",
        "text/plain",
        "application/octet-stream",
        null
      ]
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^job_[A-Za-z0-9_-]{32}$"
    },
    "artifact_handle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^art_[A-Za-z0-9_-]{32}$"
    },
    "receipt_handle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^art_[A-Za-z0-9_-]{32}$"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1048576
    },
    "max_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1048576
    },
    "source_kind": {
      "const": "synthetic_app_export_only"
    },
    "privacy_class": {
      "const": "sensitive_private"
    },
    "target": {
      "const": "disposable_emulator_only"
    },
    "synthetic_fixture_only": {
      "const": true
    },
    "real_pull_enabled": {
      "const": false
    },
    "physical_device_reads_enabled": {
      "const": false
    },
    "physical_device_writes_enabled": {
      "const": false
    },
    "raw_content_returned": {
      "const": false
    },
    "errors": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "INVALID_ACTION",
              "INVALID_INPUT",
              "SOURCE_DENIED",
              "NOT_OWNED",
              "CONSENT_REQUIRED",
              "EXECUTION_DISABLED",
              "UNVERIFIED_TARGET",
              "RECOVERY_REQUIRED",
              "JOB_UNAVAILABLE",
              "IDEMPOTENCY_CONFLICT",
              "BAD_FRAME",
              "SYMLINK_DENIED",
              "PARTIAL_TRANSFER",
              "CHECKSUM_MISMATCH",
              "TRANSFER_TOO_LARGE",
              "TIMEOUT",
              "RUNNER_FAILED",
              "ARTIFACT_EXPIRED",
            "NOT_ACTIVE",
            "CANCELLED"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 116
          }
        }
      }
    }
  }
}
