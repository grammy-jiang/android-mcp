{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:android-mcp:host-private-bugreport:v1",
  "title": "H5.a bounded sanitized synthetic bugreport private receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "status",
    "report_state",
    "avd_name",
    "avd_handle",
    "lifecycle_job_id",
    "job_id",
    "artifact_handle",
    "receipt_handle",
    "sha256",
    "size_bytes",
    "redacted_lines",
    "retention_seconds",
    "mime_type",
    "privacy_class",
    "target",
    "synthetic_fixture_only",
    "sanitized_only",
    "real_bugreport_enabled",
    "physical_device_reads_enabled",
    "physical_device_writes_enabled",
    "raw_content_returned",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runtime": {
      "const": "host"
    },
    "status": {
      "enum": [
        "planned",
        "ok",
        "blocked",
        "failed",
        "uncertain"
      ]
    },
    "report_state": {
      "enum": [
        "none",
        "sanitized_synthetic",
        "unknown"
      ]
    },
    "avd_name": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mcp_[A-Za-z0-9][A-Za-z0-9_-]{2,43}$"
    },
    "avd_handle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mcpavd_[A-Za-z0-9_-]{32}$"
    },
    "lifecycle_job_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^job_[A-Za-z0-9_-]{32}$"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^job_[A-Za-z0-9_-]{32}$"
    },
    "artifact_handle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^art_[A-Za-z0-9_-]{32}$"
    },
    "receipt_handle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^art_[A-Za-z0-9_-]{32}$"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 65536
    },
    "redacted_lines": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 128
    },
    "retention_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 300
    },
    "mime_type": {
      "const": "application/zip"
    },
    "privacy_class": {
      "const": "sensitive_private"
    },
    "target": {
      "const": "disposable_emulator_only"
    },
    "synthetic_fixture_only": {
      "const": true
    },
    "sanitized_only": {
      "const": true
    },
    "real_bugreport_enabled": {
      "const": false
    },
    "physical_device_reads_enabled": {
      "const": false
    },
    "physical_device_writes_enabled": {
      "const": false
    },
    "raw_content_returned": {
      "const": false
    },
    "errors": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "INVALID_ACTION",
              "INVALID_INPUT",
              "NOT_OWNED",
              "CONSENT_REQUIRED",
              "EXECUTION_DISABLED",
              "UNVERIFIED_TARGET",
              "RECOVERY_REQUIRED",
              "JOB_UNAVAILABLE",
              "IDEMPOTENCY_CONFLICT",
              "BAD_FRAME",
              "BAD_ARCHIVE",
              "TIMEOUT",
              "RUNNER_FAILED",
              "ARTIFACT_EXPIRED",
              "NOT_ACTIVE",
              "CANCELLED"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
